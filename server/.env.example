# Kopiraj ovaj fajl u .env i popuni vrednosti
PORT=4000
JWT_SECRET=promeni-ovo-u-nesto-slucajno-i-tajno
NODE_ENV=production

# Podešavanje admin naloga (koristi se samo prilikom "npm run seed-admin")
ADMIN_USERNAME=admin
ADMIN_PASSWORD=promeni-ovu-lozinku

# Maksimalna širina/visina slike posle automatskog smanjenja (u pikselima)
IMAGE_MAX_DIMENSION=1200
# Kvalitet JPEG kompresije (1-100)
IMAGE_QUALITY=80
